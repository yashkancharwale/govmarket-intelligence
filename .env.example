# Managed WebDev supplies DATABASE_URL, Manus OAuth values and PORT at runtime.
# Never commit credentials or place secrets in client-side code.
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST/DATABASE?sslaccept=strict
# Keep blank by default. Set to "development" only after confirming DATABASE_URL
# points to the intended development/test database, not a shared/production target.
GOVMARKET_PIB_WRITE_TARGET=
MANUS_PROJECT_ID=replace-with-platform-project-id
MANUS_JWT_SECRET=replace-with-platform-provided-signing-secret
MANUS_OAUTH_API_URL=https://oauth.example.invalid
MANUS_OAUTH_PORTAL_URL=https://oauth-portal.example.invalid

# Optional future provider variables: add only after choosing a permitted provider,
# using protected project secret configuration, and documenting its license/quotas.
# GOV_SOURCE_API_KEY=
# MARKET_DATA_API_KEY=
# X_API_BEARER_TOKEN=
